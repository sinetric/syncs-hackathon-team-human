# Copy to .env and adjust. Every value below is already the built-in default,
# so the backend runs with no .env at all.

# Distance (metres) beyond which nearby events are ignored for a location.
RELEVANCE_RADIUS_M=1000

# Proactive background monitor. "1" enables a loop that re-runs the pipeline
# for every saved location on an interval and caches the result for
# GET /pulse/{location_id}. Left off so the demo flow
# (/demo/reset -> /monitor/{id}) stays deterministic.
ENABLE_BACKGROUND_MONITOR=0
BACKGROUND_MONITOR_INTERVAL_S=1800

# Comma-separated CORS origins ("*" = allow all).
CORS_ORIGINS=*
