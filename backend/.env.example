# Copy to backend/.env — never commit .env itself.

# true  = every source adapter serves fixtures/*.json, fully offline, no keys.
# false = live upstream calls; requires the keys below.
DEMO_MODE=true

# Transport for NSW Open Data — free account, create an application and copy
# the API key: https://opendata.transport.nsw.gov.au (approval can take time —
# register early, demo on fixtures meanwhile).
TFNSW_API_KEY=

# Live Traffic NSW hazard feeds, Open-Meteo and OpenStreetMap/Overpass need
# no key (weather and map data are live even in demo mode).

# Optional: Hugging Face token for the hosted Qwen Ask-AI engine
# (https://huggingface.co/settings/tokens — read scope is enough).
# Without it the backend uses the local Qwen if installed, else a clearly
# labelled rule-based summary. Server-side only, never sent to the client.
HF_TOKEN=
# HF_CHAT_MODEL=Qwen/Qwen2.5-7B-Instruct-1M:fastest

# Optional tuning
# SOURCE_CACHE_TTL_S=120
# CORRIDOR_RADIUS_M=800
# DEPART_WINDOW_BEFORE_MIN=30
# DEPART_WINDOW_AFTER_MIN=90
# CORS_ORIGINS=http://localhost:5173

# Legacy pipeline knobs (pre-v1 endpoints)
# RELEVANCE_RADIUS_M=1000
# ENABLE_BACKGROUND_MONITOR=0
# USE_LLM=1
